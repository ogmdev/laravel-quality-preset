#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Fails when a Composer or npm dependency of the project in the current directory carries
 * a license outside the allowlist, and prints each one. It reads the installed Composer
 * packages from vendor/composer/installed.json, so run it after composer install.
 *
 * Usage: check-licenses [options]
 *   --allow=<SPDX,...>           licenses allowed everywhere (replaces the default list)
 *   --allow-dev=<SPDX,...>       licenses allowed for dev dependencies only (replaces the default list)
 *   --ignore-vendor=<prefix>     skip packages whose name starts with this prefix, e.g. acme/ (repeatable)
 *   --exception=<name>:<reason>  accept one package outside the allowlist, with the reason (repeatable)
 *   --npm-lock=<path>            npm lockfile to read (default: package-lock.json)
 *   --no-npm                     check the Composer dependencies only
 */
const DEFAULT_ALLOWED_LICENSES = ['MIT', 'BSD-2-Clause', 'BSD-3-Clause', 'Apache-2.0', 'ISC', '0BSD', 'BlueOak-1.0.0', 'CC0-1.0', 'MIT-0'];

const DEFAULT_DEV_ONLY_LICENSES = ['MPL-2.0'];

/**
 * @param  list<string>  $lines
 */
function fail(array $lines): never
{
    fwrite(STDERR, implode(PHP_EOL, $lines).PHP_EOL);
    exit(1);
}

/**
 * @param  list<string>  $arguments
 * @return array{allowed: list<string>, devOnly: list<string>, ignoredVendors: list<string>, exceptions: array<string, string>, npmLock: ?string}
 */
function options(array $arguments): array
{
    $options = [
        'allowed' => DEFAULT_ALLOWED_LICENSES,
        'devOnly' => DEFAULT_DEV_ONLY_LICENSES,
        'ignoredVendors' => [],
        'exceptions' => [],
        'npmLock' => 'package-lock.json',
    ];

    foreach ($arguments as $argument) {
        [$name, $value] = str_contains($argument, '=') ? explode('=', $argument, 2) : [$argument, null];

        if ($name === '--no-npm' && $value === null) {
            $options['npmLock'] = null;

            continue;
        }

        if ($value === null || $value === '') {
            fail([sprintf('Unknown option or missing value: [%s].', $argument)]);
        }

        match ($name) {
            '--allow' => $options['allowed'] = spdxList($value),
            '--allow-dev' => $options['devOnly'] = spdxList($value),
            '--ignore-vendor' => $options['ignoredVendors'][] = $value,
            '--exception' => $options['exceptions'] = [...$options['exceptions'], ...exception($value)],
            '--npm-lock' => $options['npmLock'] = $value,
            default => fail([sprintf('Unknown option [%s].', $name)]),
        };
    }

    return $options;
}

/**
 * @return list<string>
 */
function spdxList(string $value): array
{
    return array_values(array_filter(array_map(trim(...), explode(',', $value)), static fn (string $license): bool => $license !== ''));
}

/**
 * @return array<string, string>
 */
function exception(string $value): array
{
    [$name, $reason] = array_map(trim(...), explode(':', $value, 2)) + [1 => ''];

    if ($name === '' || $reason === '') {
        fail([sprintf('Exception [%s] needs a package name and a reason: --exception=<name>:<reason>.', $value)]);
    }

    return [$name => $reason];
}

/**
 * @return list<array{name: string, version: string, license: list<string>, dev: bool}>
 */
function composerDependencies(): array
{
    $composerJson = is_file('composer.json') ? json_decode((string) file_get_contents('composer.json'), true) : null;
    $vendorDirectory = getenv('COMPOSER_VENDOR_DIR') ?: ($composerJson['config']['vendor-dir'] ?? 'vendor');
    $installedPath = $vendorDirectory.'/composer/installed.json';

    if (! is_file($installedPath)) {
        fail([sprintf('[%s] not found: run composer install before this check.', $installedPath)]);
    }

    try {
        $installed = json_decode((string) file_get_contents($installedPath), true, 512, JSON_THROW_ON_ERROR);
    } catch (JsonException $jsonException) {
        fail([sprintf('[%s] is not valid JSON: %s', $installedPath, $jsonException->getMessage())]);
    }

    if (! is_array($installed) || ! is_array($installed['packages'] ?? null)) {
        fail([sprintf('[%s] has no "packages" key: install the dependencies with Composer 2.', $installedPath)]);
    }

    $devPackageNames = $installed['dev-package-names'] ?? [];
    $packages = [];

    foreach ($installed['packages'] as $package) {
        $name = (string) ($package['name'] ?? '?');
        $packages[] = [
            'name' => $name,
            'version' => (string) ($package['version'] ?? '?'),
            'license' => array_values(array_filter((array) ($package['license'] ?? []), is_string(...))),
            'dev' => in_array($name, $devPackageNames, true),
        ];
    }

    return $packages;
}

/**
 * Whether the SPDX expression holds with the allowed licenses alone: one side of an OR, both
 * sides of an AND. "X WITH exception" counts as X, since an exception only adds rights. An
 * expression it cannot parse is not allowed.
 *
 * @param  list<string>  $allowed
 */
function isAllowedExpression(string $expression, array $allowed): bool
{
    preg_match_all('/[()]|[^\s()]+/', $expression, $matches);
    $tokens = $matches[0];
    $position = 0;

    try {
        $holds = spdxOr($tokens, $position, $allowed);
    } catch (UnexpectedValueException) {
        return false;
    }

    return $position === count($tokens) && $holds;
}

/**
 * @param  list<string>  $tokens
 * @param  list<string>  $allowed
 */
function spdxOr(array $tokens, int &$position, array $allowed): bool
{
    $holds = spdxAnd($tokens, $position, $allowed);

    while (strtoupper($tokens[$position] ?? '') === 'OR') {
        $position++;
        $holds = spdxAnd($tokens, $position, $allowed) || $holds;
    }

    return $holds;
}

/**
 * @param  list<string>  $tokens
 * @param  list<string>  $allowed
 */
function spdxAnd(array $tokens, int &$position, array $allowed): bool
{
    $holds = spdxTerm($tokens, $position, $allowed);

    while (strtoupper($tokens[$position] ?? '') === 'AND') {
        $position++;
        $holds = spdxTerm($tokens, $position, $allowed) && $holds;
    }

    return $holds;
}

/**
 * @param  list<string>  $tokens
 * @param  list<string>  $allowed
 */
function spdxTerm(array $tokens, int &$position, array $allowed): bool
{
    $token = $tokens[$position++] ?? throw new UnexpectedValueException('Unexpected end of expression.');

    if ($token === '(') {
        $holds = spdxOr($tokens, $position, $allowed);

        if (($tokens[$position++] ?? null) !== ')') {
            throw new UnexpectedValueException('Unbalanced parenthesis.');
        }
    } elseif (isSpdxOperator($token)) {
        throw new UnexpectedValueException(sprintf('Unexpected [%s].', $token));
    } else {
        $holds = in_array($token, $allowed, true);
    }

    if (strtoupper($tokens[$position] ?? '') === 'WITH') {
        $exception = $tokens[$position + 1] ?? ')';

        if (isSpdxOperator($exception)) {
            throw new UnexpectedValueException('WITH needs an exception.');
        }

        $position += 2;
    }

    return $holds;
}

function isSpdxOperator(string $token): bool
{
    return in_array(strtoupper($token), ['(', ')', 'AND', 'OR', 'WITH'], true);
}

/**
 * Composer lists the alternative licenses of a package; npm gives one SPDX expression.
 *
 * @param  list<string>  $expressions
 * @param  list<string>  $allowed
 */
function isAllowed(array $expressions, array $allowed): bool
{
    return array_any($expressions, static fn (string $expression): bool => isAllowedExpression($expression, $allowed));
}

$options = options(array_values(array_filter(array_slice($_SERVER['argv'], 1), is_string(...))));
$packages = [];

foreach (composerDependencies() as $package) {
    $packages[] = ['composer', $package['name'], $package['version'], $package['license'], $package['dev']];
}

if ($options['npmLock'] !== null) {
    if (! is_file($options['npmLock'])) {
        fail([sprintf('npm lockfile [%s] not found: pass --npm-lock=<path>, or --no-npm when the project has no npm dependencies.', $options['npmLock'])]);
    }

    try {
        $lock = json_decode((string) file_get_contents($options['npmLock']), true, 512, JSON_THROW_ON_ERROR);
    } catch (JsonException $jsonException) {
        fail([sprintf('npm lockfile [%s] is not valid JSON: %s', $options['npmLock'], $jsonException->getMessage())]);
    }

    if (! is_array($lock) || ! is_array($lock['packages'] ?? null)) {
        fail([sprintf('npm lockfile [%s] has no "packages" key: lockfileVersion 1 is not supported, regenerate it with npm 7 or later.', $options['npmLock'])]);
    }

    foreach ($lock['packages'] as $path => $package) {
        // The root project, and the links npm places for workspaces: their target has an entry of its own.
        if ($path === '' || ($package['link'] ?? false)) {
            continue;
        }

        // A workspace lives outside node_modules, and an aliased package names its real package.
        $offset = strrpos($path, 'node_modules/');
        $name = $package['name'] ?? ($offset === false ? $path : substr($path, $offset + strlen('node_modules/')));
        $license = $package['license'] ?? null;
        $packages[] = ['npm', $name, $package['version'] ?? '?', is_string($license) ? [$license] : [], $package['dev'] ?? false];
    }
}

$violations = [];
$exceptions = [];

foreach ($packages as [$ecosystem, $name, $version, $licenses, $dev]) {
    $allowed = $dev ? [...$options['allowed'], ...$options['devOnly']] : $options['allowed'];
    $ignored = array_any($options['ignoredVendors'], static fn (string $prefix): bool => str_starts_with($name, $prefix));

    if ($ignored || isAllowed($licenses, $allowed)) {
        continue;
    }

    $line = sprintf('%s %s@%s: %s (%s)', $ecosystem, $name, $version, implode(' OR ', $licenses) ?: 'unknown', $dev ? 'dev' : 'prod');

    if (array_key_exists($name, $options['exceptions'])) {
        $exceptions[$name] = sprintf('Exception for %s, %s', $line, $options['exceptions'][$name]);
    } else {
        $violations[] = $line;
    }
}

foreach (array_keys(array_diff_key($options['exceptions'], $exceptions)) as $name) {
    $violations[] = sprintf('Unused exception for %s: remove its --exception option', $name);
}

$lines = [sprintf('%d packages checked.', count($packages)), ...array_values($exceptions)];

if ($violations !== []) {
    fail([...$lines, 'Licenses outside the allowlist:', ...$violations]);
}

echo implode(PHP_EOL, $lines).PHP_EOL;
